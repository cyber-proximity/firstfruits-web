---
import { Image } from 'astro:assets';
import type { ImageCard } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  items: ImageCard[];
  columns?: 2 | 3 | 4;
}

const { items, columns = 3 } = Astro.props;
const cols = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
const sizes = {
  2: '(min-width: 640px) 50vw, 100vw',
  3: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  4: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw',
};
---

<ul class:list={['grid gap-6', cols[columns]]}>
  {
    items.map((item) => (
      <li class="card group relative flex flex-col overflow-hidden">
        <div class="overflow-hidden">
          <Image
            src={item.image}
            alt={item.alt}
            widths={[400, 700]}
            sizes={sizes[columns]}
            class="aspect-3/2 w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
        <div class="flex flex-1 flex-col p-6">
          {(item.tag || item.meta) && (
            <div class="mb-3 flex items-center justify-between gap-3 text-sm text-muted">
              {item.tag && <span class="chip">{item.tag}</span>}
              {item.meta && <span>{item.meta}</span>}
            </div>
          )}
          <h3 class="text-xl font-semibold">
            {item.href ? (
              <a href={item.href} class="after:absolute after:inset-0 hover:text-brand-dark">
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </h3>
          {item.text && <p class="mt-3 leading-relaxed text-muted">{item.text}</p>}
          {item.href && (
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-medium text-brand-dark" aria-hidden="true">
              {item.linkLabel ?? 'Learn more'}
              <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
            </span>
          )}
        </div>
      </li>
    ))
  }
</ul>

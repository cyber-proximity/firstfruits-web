---
import type { Feature } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  items: Feature[];
  columns?: 2 | 3 | 4;
  align?: 'left' | 'center';
}

const { items, columns = 3, align = 'left' } = Astro.props;
const cols = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
const centered = align === 'center';
---

<ul class:list={['grid gap-6', cols[columns]]}>
  {
    items.map((item) => (
      <li class:list={['card flex flex-col p-6 lg:p-8', centered && 'items-center text-center']}>
        {item.icon && (
          <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-tint text-brand">
            <Icon name={item.icon} />
          </span>
        )}
        <h3 class:list={['text-xl font-semibold', item.icon && 'mt-5']}>{item.title}</h3>
        <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
        {item.tags && (
          <ul class:list={['mt-5 flex flex-wrap gap-2', centered && 'justify-center']}>
            {item.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )}
        {item.href && (
          <a href={item.href} class="mt-auto inline-flex items-center gap-1.5 pt-5 font-medium text-brand-dark hover:text-brand">
            {item.linkLabel ?? 'Learn more'}
            <span class="sr-only">about {item.title}</span>
            <Icon name="arrow-right" class="size-4" />
          </a>
        )}
      </li>
    ))
  }
</ul>

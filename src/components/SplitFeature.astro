---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Action } from '../lib/types';
import Actions from './Actions.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  title: string;
  /** Put the image on the right on large screens */
  reverse?: boolean;
  /** Use h3 when the split sits under a section heading */
  as?: 'h2' | 'h3';
  actions?: Action[];
}

const { image, imageAlt, eyebrow, title, reverse = false, as: Heading = 'h2', actions = [] } = Astro.props;
---

<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
  <div class:list={[reverse && 'lg:order-2']}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="aspect-4/3 w-full rounded-card object-cover"
    />
  </div>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading class:list={['text-3xl font-semibold lg:text-4xl', eyebrow && 'mt-3']}>{title}</Heading>
    <div class="mt-5 space-y-4 text-lg leading-relaxed text-muted">
      <slot />
    </div>
    <Actions actions={actions} class="mt-8" />
  </div>
</div>

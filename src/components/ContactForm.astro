---
// Contact form posting to Web3Forms. Submissions go to the inbox the access key is registered to.
// With JavaScript: sends with fetch and shows an inline message.
// Without JavaScript: posts normally and Web3Forms redirects to /thank-you.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const redirectUrl = new URL('/thank-you', Astro.site).href;

const topics = [
  'General enquiry',
  'Donation',
  'Volunteering',
  'Partnership',
  'Courses & workshops',
  'Events',
  'VEG ELITES nomination',
];

const field =
  'mt-2 block w-full rounded-button border border-line bg-surface px-4 py-3 text-ink placeholder:text-muted/70 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30';
---

<form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6" novalidate>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New message from the First Fruits website" />
  <input type="hidden" name="from_name" value="First Fruits website" />
  <input type="hidden" name="redirect" value={redirectUrl} />
  <!-- Honeypot: real visitors never see or fill this -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />

  {
    !accessKey && import.meta.env.DEV && (
      <p class="rounded-button border border-brand bg-brand-tint p-4 text-sm text-brand-dark">
        Developer note: PUBLIC_WEB3FORMS_KEY is not set, so submissions will fail. Add it to .env.
      </p>
    )
  }

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="font-medium">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required class={field} />
    </div>
    <div>
      <label for="cf-email" class="font-medium">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required class={field} />
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-phone" class="font-medium">Phone <span class="font-normal text-muted">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" class={field} />
    </div>
    <div>
      <label for="cf-topic" class="font-medium">What is it about?</label>
      <select id="cf-topic" name="topic" class={field}>
        {topics.map((t) => <option>{t}</option>)}
      </select>
    </div>
  </div>

  <div>
    <label for="cf-message" class="font-medium">Message</label>
    <textarea id="cf-message" name="message" rows="6" required class={field}></textarea>
  </div>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <button type="submit" class="btn btn-primary disabled:opacity-60">Send message</button>
    <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#contact-status');

  // Preselect the topic from the URL, e.g. /contact?topic=donation
  const topic = new URLSearchParams(location.search).get('topic');
  const select = form?.querySelector<HTMLSelectElement>('select[name="topic"]');
  if (topic && select) {
    const match = [...select.options].find((o) => o.text.toLowerCase().startsWith(topic.toLowerCase()));
    if (match) select.value = match.text;
  }

  const setStatus = (message: string, ok: boolean) => {
    if (!status) return;
    status.textContent = message;
    status.className = `text-sm font-medium ${ok ? 'text-ink' : 'text-brand-dark'}`;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = Object.fromEntries(new FormData(form));
    delete data.redirect;

    button?.setAttribute('disabled', '');
    setStatus('Sending…', true);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message);
      form.reset();
      setStatus('Thank you. Your message has been sent and we will reply soon.', true);
    } catch {
      setStatus('Sorry, your message could not be sent. Please try again or email us directly.', false);
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>

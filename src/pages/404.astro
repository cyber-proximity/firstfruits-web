---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">404</p>
    <h1 class="mt-4 text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-muted">The page you are looking for has moved or does not exist.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-button bg-brand px-6 py-3 font-medium text-white hover:bg-brand-hover"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
